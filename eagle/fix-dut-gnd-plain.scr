# Ground the DUT- terminal (net M-: X2-1 + S1.P1) with a GND flag.
# For: LCmeter0-LCD-8pinlcd.sch, ...-alt.sch, ...-alt2.sch
# Run in the schematic editor (File > Execute Script). Answer Yes to the
# "merge net segment" question, then run ERC.
GRID MM;
SET WIRE_BEND 2;
NET (-53.34 17.78) (-53.34 15.24);
ADD GND@supply1 R0 (-53.34 15.24);
